# Copy this file to .env and fill in real values before running docker compose up.
# See README.md for full setup instructions.

# --- Database ---
POSTGRES_PASSWORD=change-me-to-a-long-random-value

# --- Encryption & sessions (all required) ---
# 32-byte key, base64-encoded. Generate with:
#   openssl rand -base64 32
# This key wraps each account's per-account data encryption key. Back it up
# somewhere safe and separate from your database backups: losing it makes
# ALL encrypted data (VINs, notes, costs, etc.) permanently unrecoverable.
MASTER_ENCRYPTION_KEY=

# Random secrets used to sign login sessions. Generate each with:
#   openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- Networking ---
# Public URL of the app (used for CORS). Change if you put this behind your
# own reverse proxy / domain.
APP_URL=http://localhost:8080
# Port the client container publishes on the Docker host.
HTTP_PORT=8080
# Set to false only for local testing over plain HTTP. Leave true in production
# (requires HTTPS, e.g. via your reverse proxy) so the login session cookie is
# only ever sent over an encrypted connection.
COOKIE_SECURE=true

# --- Reminder emails ---
# One of: none, smtp, resend
MAIL_PROVIDER=none
MAIL_FROM=Car Tracker <no-reply@example.com>

# SMTP settings (only used when MAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Resend API key (only used when MAIL_PROVIDER=resend)
RESEND_API_KEY=

# Cron expression (UTC) for how often to check for due reminders.
REMINDER_CRON=0 8 * * *
